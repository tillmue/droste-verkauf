rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Freigabe und Rolle kommen als Claims im Anmelde-Token (gesetzt von der Funktion syncClaims)
    function member() { return request.auth != null && request.auth.token.approved == true; }
    function editor() { return member() && request.auth.token.role in ['admin', 'chef', 'demo']; }
    function okFile() { return request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }

    // Fotos zu Meldungen: jedes freigegebene Mitglied darf hochladen
    match /meldungen/{file} {
      allow read: if member();
      allow write: if member() && okFile();
    }
    // Bilder (Schonungen, Standpläne): alle freigegebenen Mitglieder lesen, nur Admin und Chef laden hoch
    match /{allPaths=**} {
      allow read: if member();
      allow write: if editor() && okFile();
    }
  }
}
