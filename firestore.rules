rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isMember() { return signedIn() && exists(userDoc(request.auth.uid)); }
    function role() { return get(userDoc(request.auth.uid)).data.role; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    function isSales() { return isMember() && role() in ['admin', 'verkauf']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function inviteDoc(email) { return /databases/$(database)/documents/invites/$(email); }

    // Nutzer: Anlegen nur mit passender Einladung, Rolle kommt aus der Einladung
    match /users/{uid} {
      allow read: if isMember();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(inviteDoc(myEmail()))
        && request.resource.data.role == get(inviteDoc(myEmail())).data.role
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'created']);
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    // Einladungen: nur Admin verwaltet, jeder darf nur die eigene lesen
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    // Aufgaben und Termine
    match /tasks/{id} {
      allow read, create: if isMember();
      allow update: if isMember() && (isAdmin()
        || resource.data.createdBy == request.auth.uid
        || resource.data.assignee == request.auth.uid);
      allow delete: if isMember() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // Brain-Dump-Notizen: nur eigene, Admin sieht alle
    match /notes/{id} {
      allow read: if isMember() && (isAdmin() || resource.data.owner == request.auth.uid);
      allow create: if isMember() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isMember() && (isAdmin() || resource.data.owner == request.auth.uid);
    }

    // Preisliste und Stände: alle lesen, Admin pflegt
    match /products/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /stands/{id}   { allow read: if isMember(); allow write: if isAdmin(); }

    // Verkaufszahlen und Bestandsbewegungen: nur Admin und Verkauf
    match /sales/{id} { allow read, write: if isSales(); }
    match /moves/{id} { allow read, write: if isSales(); }
  }
}
