rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    // Mitglied = hat ein Benutzerdokument UND wurde vom Admin freigegeben
    function isMember() { return signedIn() && exists(userDoc(request.auth.uid)) && get(userDoc(request.auth.uid)).data.approved == true; }
    function role() { return get(userDoc(request.auth.uid)).data.role; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    function isSales() { return isMember() && role() in ['admin', 'verkauf']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function inviteDoc(email) { return /databases/$(database)/documents/invites/$(email); }

    // Benutzer: Selbstregistrierung mit E-Mail und Passwort (Firebase Auth), Konto startet
    // als Standardbenutzer (team) und NICHT freigegeben. Der Admin gibt frei und vergibt Rollen.
    // Ausnahme: Der erste Admin (Till) wird ueber eine von Hand angelegte Einladung erzeugt.
    match /users/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'approved', 'created'])
        && request.resource.data.email == myEmail()
        && (
          (request.resource.data.role == 'team' && request.resource.data.approved == false)
          || (exists(inviteDoc(myEmail()))
              && request.resource.data.role == get(inviteDoc(myEmail())).data.role
              && request.resource.data.approved == true)
        );
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    // Einladungen (nur fuer den ersten Admin): nur Admin verwaltet, jeder liest nur die eigene
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    // Aufgaben und Termine
    match /tasks/{id} {
      allow read, create: if isMember();
      allow update: if isMember();   // jeder darf jede Aufgabe uebernehmen, abhaken oder ins Archiv schieben
      allow delete: if false;        // kein echtes Loeschen, nur Archiv (Feld deleted)
    }

    // Kalendereintraege (Saison, Lieferungen, Instagram)
    match /events/{id} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }

    // Brain-Dump-Notizen: nur eigene, Admin sieht alle
    match /notes/{id} {
      allow read: if isMember() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isMember() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }

    // Preisliste und Stände: alle Freigegebenen lesen, Admin pflegt
    match /products/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /stands/{id}   { allow read: if isMember(); allow write: if isAdmin(); }

    // Verkaufszahlen und Bestandsbewegungen: nur Admin und Verkauf
    match /sales/{id} { allow read, write: if isSales(); }
    match /moves/{id} { allow read, write: if isSales(); }
  }
}
